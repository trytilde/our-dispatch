{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "XDG_CACHE_HOME=.cache pnpm openbot:generate && pnpm contracts:generate && XDG_CACHE_HOME=.cache turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "XDG_CACHE_HOME=.cache pnpm openbot:generate && pnpm contracts:generate && XDG_CACHE_HOME=.cache tsc -p scripts/tsconfig.json && XDG_CACHE_HOME=.cache turbo run typecheck lint test && pnpm vitest run scripts",
    "contracts:generate": "XDG_CACHE_HOME=.cache pnpm --filter @openbot/contracts generate",
    "db:migrate": "pnpm --filter @openbot/db migrate",
    "dev": "tsx scripts/dev.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "deploy:prod": "tsx scripts/deploy-prod.ts",
    "openbot:generate": "tsx scripts/generate-repository.ts",
    "openbot": "tsx scripts/openbot.tsx",
    "test": "vitest run scripts && turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "XDG_CACHE_HOME=.cache pnpm openbot:generate && pnpm contracts:generate && XDG_CACHE_HOME=.cache tsc -p scripts/tsconfig.json && XDG_CACHE_HOME=.cache turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.7",
    "@ai-sdk/openai": "3.0.94",
    "@openbot/config": "workspace:*",
    "@openbot/db": "workspace:*",
    "@openbot/providers": "workspace:*",
    "@playwright/test": "1.55.0",
    "@trytilde/cli": "0.1.0",
    "@trytilde/harness-sdk-vercel-ai-node": "0.2.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@vercel/sandbox": "3.0.0",
    "ai": "6.0.250",
    "dotenv": "17.2.1",
    "ink": "7.1.1",
    "ink-testing-library": "4.0.0",
    "react": "19.2.8",
    "tsx": "4.20.4",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vercel": "58.9.4",
    "vitest": "3.2.4",
    "yaml": "2.9.0"
  }
}
