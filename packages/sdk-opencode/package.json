{
  "name": "@trytilde/sdk-opencode",
  "version": "0.2.0",
  "description": "OpenCode plugin adapter for Tilde ChatKit coding-agent audit events.",
  "homepage": "https://github.com/trytilde/dispatch/tree/main/packages/sdk-opencode#readme",
  "bugs": {
    "url": "https://github.com/trytilde/dispatch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trytilde/dispatch.git",
    "directory": "packages/sdk-opencode"
  },
  "files": [
    "dist",
    "plugin",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.node.config.ts",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trytilde/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
