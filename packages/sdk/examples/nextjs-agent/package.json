{
  "name": "tilde-nextjs-agent-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca next dev --webpack",
    "login": "NODE_OPTIONS=--use-system-ca openbot auth login",
    "whoami": "NODE_OPTIONS=--use-system-ca openbot auth whoami",
    "tunnel": "NODE_OPTIONS=--use-system-ca openbot tunnel -- next dev --webpack -p '$TUNNEL_PORT'",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.46",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/react": "^3.0.199",
    "@trytilde/sdk": "link:../..",
    "@trytilde/sdk-vercel-ai-node": "link:../../../sdk-vercel-ai-node",
    "ai": "^6.0.197",
    "next": "^16.2.7",
    "openbot": "link:../../../../cli",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
