{
  "name": "@tryopenbot/utilities",
  "version": "1.0.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./file-template": {
      "types": "./src/file-template.ts",
      "development": "./src/file-template.ts",
      "import": "./dist/file-template.js"
    },
    "./json": {
      "types": "./src/json.ts",
      "development": "./src/json.ts",
      "import": "./dist/json.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./file-template": {
        "types": "./dist/file-template.d.ts",
        "import": "./dist/file-template.js"
      },
      "./json": {
        "types": "./dist/json.d.ts",
        "import": "./dist/json.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.node.config.ts && node ../../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "handlebars": "4.7.9"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
