{
  "name": "@tryopenbot/computer-service-proto",
  "version": "1.0.0",
  "files": [
    "dist",
    "README.md",
    "proto"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./gen/*": {
      "types": "./src/gen/*.ts",
      "development": "./src/gen/*.ts",
      "import": "./dist/gen/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./gen/*": {
        "types": "./dist/gen/*.d.ts",
        "import": "./dist/gen/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.browser.config.ts && node ../../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "generate": "BUF_CACHE_DIR=../../.cache/buf buf generate",
    "lint": "vp lint",
    "proto:lint": "BUF_CACHE_DIR=../../.cache/buf buf lint",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.7.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.57.2",
    "@bufbuild/protoc-gen-es": "2.7.0",
    "@types/node": "24.3.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
