{
  "name": "@tryopenbot/runtime-provider",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/core.ts",
      "development": "./src/core.ts",
      "import": "./dist/core.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.node.config.ts && node ../../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
