{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "openbot plugin audit --cli codex", "async": true }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "openbot plugin audit --cli codex", "async": true }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "openbot plugin audit --cli codex", "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "openbot plugin audit --cli codex", "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "openbot plugin audit --cli codex", "async": true }
        ]
      }
    ]
  }
}
