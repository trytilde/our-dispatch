{
  "name": "@tryopenbot/configuration",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./instrumentation": {
      "types": "./src/instrumentation.ts",
      "development": "./src/instrumentation.ts",
      "import": "./dist/instrumentation.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./instrumentation": {
        "types": "./dist/instrumentation.d.ts",
        "import": "./dist/instrumentation.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.node.config.ts && node ../../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tryopenbot/agent-provider": "workspace:*",
    "@tryopenbot/agent-service-provider": "workspace:*",
    "@tryopenbot/auth-provider": "workspace:*",
    "@tryopenbot/computer-provider": "workspace:*",
    "@tryopenbot/control-service-provider": "workspace:*",
    "@tryopenbot/inference-provider": "workspace:*",
    "@tryopenbot/runtime-provider": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
