    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.27",
    "@tryopenbot/utilities": "workspace:*",
    "ai": "7.0.64",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite-plus": "catalog:",
    "vitest": "3.2.4"
  }
}
