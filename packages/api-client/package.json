{
  "name": "@trytilde/api-client",
  "version": "0.1.2",
  "description": "Generated Tilde API client and helpers.",
  "homepage": "https://github.com/trytilde/dispatch/tree/main/packages/api-client#readme",
  "bugs": {
    "url": "https://github.com/trytilde/dispatch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trytilde/dispatch.git",
    "directory": "packages/api-client"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "development": "./src/generated/index.ts",
      "import": "./dist/generated/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./generated": {
        "types": "./dist/generated/index.d.ts",
        "import": "./dist/generated/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.browser.config.ts",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite-plus": "catalog:",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
