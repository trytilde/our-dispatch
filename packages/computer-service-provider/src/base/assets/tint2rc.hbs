# OpenBot's permanent owner taskbar: deliberately limited to the two useful applications.
rounded = 0
border_width = 1
border_sides = T
background_color = #111827 96
border_color = #ffffff 18

panel_items = L
panel_position = bottom center horizontal
panel_size = 100% 54
panel_margin = 0 0
panel_padding = 14 6 14
panel_background_id = 1
panel_layer = top
panel_monitor = all
panel_dock = 1
strut_policy = follow_size
wm_menu = 0
autohide = 0

