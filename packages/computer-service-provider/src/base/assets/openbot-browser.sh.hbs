#!/usr/bin/env bash
set -euo pipefail

profile_directory="${HOME}/browser-profile"
mkdir -p "$profile_directory"

if command -v google-chrome-stable >/dev/null 2>&1; then
  exec google-chrome-stable \
    --no-sandbox \
    --disable-dev-shm-usage \
    --disable-gpu \
    --user-data-dir="$profile_directory"
fi

exec chromium \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --user-data-dir="$profile_directory"
