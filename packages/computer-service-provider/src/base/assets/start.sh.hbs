#!/usr/bin/env bash
set -euo pipefail

: "${COMPUTER_SERVICE_API_KEY:?COMPUTER_SERVICE_API_KEY is required}"
: "${COMPUTER_ID:?COMPUTER_ID is required}"

# Keep all mutable browser and runtime data on the persistent computer workspace.
export DISPLAY="${DISPLAY:-:1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/openbot-runtime}"
export COMPUTER_GEOMETRY="${COMPUTER_GEOMETRY:-1440x810}"

mkdir -p "$XDG_RUNTIME_DIR" /workspace/.openbot/desktops
chmod 0700 "$XDG_RUNTIME_DIR"

# Serialize startup so create, wake, and retries cannot launch duplicate process trees.
start_lock=/tmp/openbot-computer-start.lock
owner_file="$start_lock/owner"
current_boot="$(cat /proc/sys/kernel/random/boot_id)"
for _ in $(seq 1 20); do
  if mkdir "$start_lock" 2>/dev/null; then
    printf '%s %s\n' "$current_boot" "$$" > "$owner_file"
    break
  fi
  locked_boot=''
  locked_pid=''
  if read -r locked_boot locked_pid < "$owner_file" 2>/dev/null \
      && [[ "$locked_boot" == "$current_boot" ]] \
      && kill -0 "$locked_pid" 2>/dev/null; then
    exit 0
  fi
  rm -f "$owner_file"
  rmdir "$start_lock" 2>/dev/null || true
  sleep 0.05
done

cleanup_lock() {
  rm -f "$owner_file"
  rmdir "$start_lock" 2>/dev/null || true
}
trap cleanup_lock EXIT

# Remove a stale gateway left by a restarted service. Agent display processes
# remain owned by computer-service and are reconciled individually.
pkill -f 'websockify.*6080' >/dev/null 2>&1 || true

# computer-service adds one capability mapping per agent display. Keep the
# token file across service restarts so live preview URLs remain stable.
touch /opt/openbot/novnc.tokens
chmod 0600 /opt/openbot/novnc.tokens
websockify --web=/usr/share/novnc --token-plugin TokenFile \
  --token-source /opt/openbot/novnc.tokens 0.0.0.0:6080 \
  >/var/log/openbot-novnc.log 2>&1 &

# Start the API-key-protected service that owns every agent display and input path.
node /opt/openbot/computer-service.mjs >/var/log/openbot-computer-service.log 2>&1 &

# Treat any critical child exiting as a computer startup failure.
wait -n
