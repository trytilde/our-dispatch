{
  "name": "@tryopenbot/computer-tools",
  "version": "1.0.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.node.config.ts && node ../../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.27",
    "@bufbuild/protobuf": "2.7.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@tryopenbot/computer-service-proto": "workspace:*",
    "@tryopenbot/utilities": "workspace:*",
    "@trytilde/sdk": "workspace:*",
    "@trytilde/sdk-vercel-ai-node": "workspace:*",
    "ai": "7.0.64",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
