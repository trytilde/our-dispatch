{
  "name": "@tryopenbot/ui",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./beautiful-ui.css": {
      "development": "./src/beautiful-ui/upstream/globals.css",
      "default": "./dist/beautiful-ui/upstream/globals.css"
    },
    "./openbot-ui.css": {
      "development": "./src/openbot-ui.css",
      "default": "./dist/openbot-ui.css"
    },
    "./beautiful-ui/*": {
      "types": "./src/beautiful-ui/upstream/*.tsx",
      "development": "./src/beautiful-ui/upstream/*.tsx",
      "import": "./dist/beautiful-ui/upstream/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./beautiful-ui.css": "./dist/beautiful-ui/upstream/globals.css",
      "./openbot-ui.css": "./dist/openbot-ui.css",
      "./beautiful-ui/*": {
        "types": "./dist/beautiful-ui/upstream/*.d.ts",
        "import": "./dist/beautiful-ui/upstream/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.browser.config.ts && node ../../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "6.0.250",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "glimm": "0.3.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.1.2",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "react-dom": "19.1.2",
    "storybook": "10.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
