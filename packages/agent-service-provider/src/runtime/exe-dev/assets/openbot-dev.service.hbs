[Unit]
Description=OpenBot trusted development runtime
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{{WORKING_DIRECTORY}}}
EnvironmentFile={{{ENVIRONMENT_FILE}}}
ExecStart=/bin/bash -lc 'exec pnpm dev'
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=default.target
