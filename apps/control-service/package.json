{
  "name": "@tryopenbot/control-service",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "artifact:check": "tsgo --noEmit",
    "build": "vp run artifact:check && tsdown",
    "check": "vp check",
    "dev": "tsx watch src/index.ts",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "start": "tsx src/index.ts",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.1",
    "@tryopenbot/auth-provider": "workspace:*",
    "@tryopenbot/computer-provider": "workspace:*",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
