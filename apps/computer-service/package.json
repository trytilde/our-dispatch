{
  "name": "@tryopenbot/computer-service",
  "version": "0.1.0",
  "bin": {
    "openbot-computer-service": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "artifact:check": "tsgo --noEmit",
    "build": "vp run artifact:check && tsdown",
    "check": "vp check",
    "dev": "tsx watch src/index.ts",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.7.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@trycua/cua-driver": "0.21.0",
    "@tryopenbot/computer-service-proto": "workspace:*",
    "@tryopenbot/utilities": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "0.22.14",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
