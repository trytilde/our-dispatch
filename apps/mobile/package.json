{
  "name": "@tryopenbot/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "android": "vp run --filter openbot start -- mobile expo run:android",
    "build": "vp run --filter openbot start -- mobile expo export --platform all --output-dir dist",
    "check": "vp check",
    "dev": "vp run --filter openbot start -- mobile expo start --dev-client --clear",
    "eas-build-post-install": "pnpm --filter @tryopenbot/client-runtime build",
    "ios": "vp run --filter openbot start -- mobile expo run:ios",
    "start": "vp run --filter openbot start -- mobile expo start",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.14",
    "@assistant-ui/react-native": "0.1.37",
    "@expo-google-fonts/inter": "0.4.2",
    "@tryopenbot/client-runtime": "workspace:*",
    "assistant-cloud": "0.1.41",
    "expo": "~57.0.14",
    "expo-auth-session": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
