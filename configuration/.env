# Tilde proxied Vercel MCP server ID for factory.
AGENT_FACTORY_VERCEL_MCP_SERVER_ID="3153d656-f103-469a-b399-4460d12a9e24"
# Tilde agent ID for factory.
AGENT_FACTORY_AGENT_ID="factory"
# Tilde agent provider ID for hello-world.
AGENT_FACTORY_PROVIDER_ID="chatkit.http-vercel-ai-sdk"
AI_MODEL=openai/gpt-5.2
# Agent service origin.
AGENT_SERVICE_ORIGIN="https://our-ob-agents.vercel.app"
# OpenBot public origin.
PUBLIC_ORIGIN="https://our-ob-control.vercel.app"
# Deployed vercel-sandbox computer image.
VERCEL_COMPUTER_IMAGE="vcr.vercel.com/trysoma/our-ob-agents/openbot-computer:openbot-computer-e55b66b20e7b"
# Trusted development sandbox ID.
DEVELOPMENT_SANDBOX_ID="openbot-development"
# Name shown to members of the selected Tilde team.
OPENBOT_DEPLOYMENT_NAME="OpenBot"
# Tilde OIDC public client ID for this OpenBot installation.
OPENBOT_OIDC_CLIENT_ID="tilde-dcr-qo8xKEj-v6DgpkD4w4e2y8Fi1jABmMUj"
# Audience accepted by this OpenBot installation.
OPENBOT_OIDC_AUDIENCE="urn:tilde:openbot:tilde-dcr-qo8xKEj-v6DgpkD4w4e2y8Fi1jABmMUj"
# Tilde token issuer for this OpenBot installation.
OPENBOT_OIDC_ISSUER="https://org-19ef5d10-5a5f-43b1-8139-1183a51b9124.api.trytilde.ai/api/v1/team/e113f6ed-f45f-4639-8120-a3188d357bc1/identity/oauth"
# OIDC scopes requested by OpenBot.
OPENBOT_OIDC_SCOPE="openid profile email offline_access openbot:control"
# Tilde OIDC authorization endpoint.
OPENBOT_OIDC_AUTHORIZATION_ENDPOINT="https://api.trytilde.ai/api/v1/identity/oauth/authorize"
# Tilde OIDC token endpoint.
OPENBOT_OIDC_TOKEN_ENDPOINT="https://api.trytilde.ai/api/v1/identity/oauth/token"
# Tilde OIDC signing key endpoint.
OPENBOT_OIDC_JWKS_URI="https://api.trytilde.ai/api/v1/identity/.well-known/jwks.json"
# GitHub repository (owner/name) holding this OpenBot fork.
GIT_GITHUB_REPOSITORY="trytilde/our-openbot"
# Tilde GitHub tool group instance ID.
GIT_GITHUB_TOOL_GROUP_ID="common-provider-tool-github-cad11206-2a68-4639-baf5-39d350902897"
# Name of the GitHub App created for this installation. GitHub App names are globally unique, so include something identifying; GitHub lets you adjust it on the creation page.
GIT_GITHUB_APP_NAME="openbot"
# GitHub organization that will own and install the App. Leave blank to create it on the authorizing user's account.
GIT_GITHUB_APP_ORGANIZATION="trytilde"
# Tilde resource server credential ID for GitHub.
GIT_GITHUB_CREDENTIAL_ID="cad11206-2a68-4639-baf5-39d350902897"
# Tilde reverse-proxy profile ID for the GitHub REST API.
GIT_GITHUB_REST_PROXY_PROFILE_ID="openbot-github-rest"
# Tilde reverse-proxy profile ID for GitHub git-over-HTTPS.
GIT_GITHUB_GIT_PROXY_PROFILE_ID="openbot-github-git"
# Trusted development sandbox computer service URL.
DEVELOPMENT_SANDBOX_SERVICE_URL="http://127.0.0.1:4101/rpc"
# Computer service URL used by the factory agent's tools.
AGENT_FACTORY_COMPUTER_SERVICE_URL="http://127.0.0.1:4101/rpc"
