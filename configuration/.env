# Optional Vercel team scope shared by all OpenBot Vercel resources.
VERCEL_TEAM_ID="trysoma"
# Name of the Vercel project that will host the OpenBot control service and web application.
VERCEL_CONTROL_PROJECT="our-ob-control"
# Name of the Vercel project that will host OpenBot agent functions and own their Container Registry namespace.
VERCEL_AGENT_PROJECT="our-ob-agents"
# Organization that owns this OpenBot installation's Tilde resources.
TILDE_ORG_ID="org-19ef5d10-5a5f-43b1-8139-1183a51b9124"
# Team that owns this OpenBot installation's agents, chats, tools, and skills.
TILDE_TEAM_ID="e113f6ed-f45f-4639-8120-a3188d357bc1"
# Human-readable label for the API key created for this OpenBot installation.
VERCEL_AI_GATEWAY_API_KEY_NAME="openbot-2"
# Display name for the factory agent.
AGENT_FACTORY_NAME="Factory"
# Deployed microsandbox computer image.
MICROSANDBOX_COMPUTER_IMAGE="trytilde/our-openbot-computer:openbot-computer-b0a1f8b5d337"
# OpenBot computer ID.
COMPUTER_ID="openbot-computer"
# OpenBot computer service URL.
COMPUTER_SERVICE_URL="http://127.0.0.1:4102/rpc"
# Optional alternate Tilde API origin.
TILDE_BASE_URL="https://api.trytilde.ai"
# Tilde skill registry ID for hello-world.
AGENT_FACTORY_SKILL_REGISTRY_ID="14bf094f-591f-423a-b05d-044f563f55b0"
# Tilde MCP server ID for hello-world.
AGENT_FACTORY_MCP_SERVER_ID="openbot-hello-world"
# Tilde control-plane toolkit group ID for factory.
AGENT_FACTORY_TILDE_CONTROL_PLANE_TOOL_GROUP_ID="openbot-factory-tilde-control-plane"
