import { createGlobTool } from "@tryopenbot/computer-tools";

// An agent-specific computer overrides the shared computer, e.g. the factory agent's
// trusted development sandbox.
const baseUrl = () =>
  process.env.AGENT_{{AGENT_ENV_PREFIX}}_COMPUTER_SERVICE_URL ??
  process.env.COMPUTER_SERVICE_URL!;

export default createGlobTool({ agentId: {{{AGENT_ID_JSON}}}, baseUrl });
