{
  "name": "openbot",
  "version": "0.1.0",
  "bin": {
    "openbot": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown && node ../scripts/copy-package-assets.mjs",
    "check": "vp check",
    "deploy": "node --conditions=development --import tsx src/index.tsx deploy",
    "dev": "node --conditions=development --import tsx src/index.tsx dev",
    "lint": "vp lint",
    "start": "node --conditions=development --import tsx src/index.tsx",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.1",
    "@tryopenbot/agent-provider": "workspace:*",
    "@tryopenbot/agent-service-provider": "workspace:*",
    "@tryopenbot/auth-provider": "workspace:*",
    "@tryopenbot/computer-service-provider": "workspace:*",
    "@tryopenbot/computer-tools": "workspace:*",
    "@tryopenbot/configuration": "workspace:*",
    "@tryopenbot/connector-tools": "workspace:*",
    "@tryopenbot/control-service": "workspace:*",
    "@tryopenbot/control-service-provider": "workspace:*",
    "@tryopenbot/git-provider": "workspace:*",
    "@tryopenbot/inference-provider": "workspace:*",
    "@tryopenbot/platform-integrations": "workspace:*",
    "@tryopenbot/runtime-provider": "workspace:*",
    "@tryopenbot/utilities": "workspace:*",
    "@trytilde/api-client": "github:trytilde/harness-sdk#c9b64d691486e6d57ff69cd0eb0214ceb6d1c13d&path:packages/api-client",
    "@trytilde/cli": "0.1.0",
    "arg": "5.0.2",
    "dotenv": "17.2.1",
    "hono": "4.13.1",
    "ink": "7.1.1",
    "react": "19.2.8",
    "tsx": "4.20.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
