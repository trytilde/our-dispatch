import {
  chatKitEndpoint,
  convertToAiSdkMessages,
  createClient,
  createMCPClient,
  createMemorySynthesisInferenceRun,
  didMemorySynthesisFinish,
  HostedInferenceCreditsExhaustedError,
  HostedInferenceReconciliationRequiredError,
  MemorySynthesisRunAlreadyClaimedError,
  MemorySynthesisRunCompletedError,
  MemorySynthesisRunTerminalError,
  restrictMemorySynthesisTools,
} from "@trytilde/sdk-vercel-ai-node";
import { consumeStream, convertToModelMessages, stepCountIs, streamText } from "ai";
import type { ToolSet } from "@ai-sdk/provider-utils";
import { prepareInference } from "./inference.js";
import instructions from "./instructions.js";

const client = createClient({
  apiKey: process.env.AGENT_{{AGENT_ENV_PREFIX}}_API_KEY!,
  orgId: process.env.TILDE_ORG_ID!,
  orgSubdomain: false,
  teamId: process.env.TILDE_TEAM_ID!,
});

export default chatKitEndpoint({
  client,
  responseMode: "agentLoop",
  webhookSigningKey: process.env.AGENT_{{AGENT_ENV_PREFIX}}_WEBHOOK_SIGNING_KEY!,
  requestTimeoutMs: 285_000,
  async handler(request, context) {
    const localTools = context.session.memorySynthesisTools();
    const mcp = await createMCPClient({
      client,
      agentId: {{{AGENT_ID_JSON}}},
      serverId: process.env.AGENT_{{AGENT_ENV_PREFIX}}_MCP_SERVER_ID!,
      chatkit: { sessionId: context.sessionId },
      tools: localTools,
    });
    // This strict allowlist also excludes remote batch wrappers, so they cannot
    // be used to reach a filtered communication or control-plane tool.
    const tools = restrictMemorySynthesisTools(await mcp.mcp.tools(), localTools);
    try {
      const inferenceModelId = process.env.AI_MODEL ?? "openai/gpt-5.6-sol";
      let synthesisRun;
      try {
        synthesisRun = await createMemorySynthesisInferenceRun({
          runs: client.chatkit.runs,
          credits: client.billing.aiCredits,
          sessionId: context.sessionId,
          agentId: {{{AGENT_ID_JSON}}},
          webhookId: context.webhookId,
          messages: context.messages,
          billingEnabled: process.env.OPENBOT_HOSTED_INFERENCE_BILLING === "1",
          validateBatch: (input) =>
            client.memory.synthesisSession(context.sessionId).validateBatch(input),
          estimatedCostMicrousd: positiveIntegerEnv(
            "OPENBOT_HOSTED_INFERENCE_RESERVE_MICROUSD",
            250_000,
          ),
          tags: ["hosted-openbot", "agent:memory-catcher", "purpose:memory-synthesis"],
        });
      } catch (error) {
        await mcp.closeMcp();
        if (error instanceof MemorySynthesisRunAlreadyClaimedError) {
          return Response.json({ status: "run_already_claimed", run_id: error.runId }, { status: 202 });
        }
        if (error instanceof MemorySynthesisRunCompletedError) {
          return Response.json({ status: "already_completed", run_id: error.runId });
        }
        if (error instanceof MemorySynthesisRunTerminalError) {
          return Response.json(
            { error: "inference_reconciliation_required", run_id: error.runId },
            { status: 503 },
          );
        }
        throw error;
      }
      const history = await context.session.history();
      const messages = await convertToAiSdkMessages({
        messages: [...history.items, ...context.messages],
        chatkit: context.chatkit,
      });
      const closeMcp = () => void mcp.closeMcp();
      const inference = await prepareInference(tools as ToolSet, request.signal);
      const modelMessages = (await convertToModelMessages(messages)).filter(
        (message) => message.role !== "system",
      );
      try {
        await synthesisRun.billing.preflight(inferenceModelId);
      } catch (error) {
        await mcp.closeMcp();
        if (error instanceof HostedInferenceCreditsExhaustedError) {
          await synthesisRun.pauseForCredits();
          return Response.json(
            { error: "ai_credits_exhausted", message: error.message },
            { status: 402 },
          );
        }
        if (error instanceof HostedInferenceReconciliationRequiredError) {
          await synthesisRun.failForReconciliation();
          return Response.json({ error: "inference_reconciliation_required" }, { status: 503 });
        }
        await synthesisRun.fail(error);
        throw error;
      }
      const result = streamText({
        ...inference,
        instructions,
        messages: modelMessages,
        stopWhen: stepCountIs(50),
        abortSignal: request.signal,
        onLanguageModelCallStart: synthesisRun.billing.onLanguageModelCallStart,
        onLanguageModelCallEnd: synthesisRun.billing.onLanguageModelCallEnd,
        onChunk: synthesisRun.billing.onChunk,
        onFinish: async (finish) => {
          try {
            const synthesisFinished = didMemorySynthesisFinish({
              batchId: synthesisRun.invocation.batchId,
              text: finish.text,
              steps: finish.steps,
            });
            await synthesisRun.complete({
              inputTokens: finish.totalUsage.inputTokens ?? 0,
              outputTokens: finish.totalUsage.outputTokens ?? 0,
              toolCallCount: finish.steps.reduce(
                (count, step) => count + step.toolCalls.length,
                0,
              ),
              responseText: finish.text,
              synthesisFinished,
            });
          } finally {
            closeMcp();
          }
        },
        onError: async ({ error }) => {
          console.error("[memory-catcher] inference stream failed", safeInferenceError(error));
          try {
            await synthesisRun.fail(error);
          } finally {
            closeMcp();
          }
        },
        onAbort: async () => {
          try {
            await synthesisRun.fail();
          } finally {
            closeMcp();
          }
        },
      });
      return result.toUIMessageStreamResponse({
        consumeSseStream: consumeStream,
        originalMessages: messages,
      });
    } catch (error) {
      await mcp.closeMcp();
      throw error;
    }
  },
});

function positiveIntegerEnv(name: string, fallback: number): number {
  const value = Number(process.env[name] ?? fallback);
  return Number.isSafeInteger(value) && value > 0 ? value : fallback;
}

function safeInferenceError(error: unknown): { name: string; message?: string } {
  if (!(error instanceof Error)) return { name: typeof error };
  return { name: error.name, message: error.message.slice(0, 500) };
}
