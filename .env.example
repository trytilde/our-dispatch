# Local control server
OPENBOT_SETUP_CODE=replace-with-at-least-32-random-bytes
OPENBOT_PUBLIC_ORIGIN=

# Model provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Tilde registration and ChatKit
TILDE_API_KEY=
TILDE_ORG_ID=
TILDE_TEAM_ID=

# Runtime agent pull-request publication (repository-scoped token)
OPENBOT_GITHUB_REPOSITORY=owner/openbot
OPENBOT_GITHUB_TOKEN=

# Vercel deployment status and production automation
OPENBOT_VERCEL_API_TOKEN=
OPENBOT_VERCEL_PROJECT_ID=
OPENBOT_VERCEL_TEAM_ID=

# Declare sandbox-only values in configuration/sandbox/secrets.example.yaml, then set each as:
# OPENBOT_SANDBOX_SECRET_EXAMPLE=
